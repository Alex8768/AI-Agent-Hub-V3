# ==============================================================================
# AI AGENT HUB V3 - CONFIG TEMPLATE (HYBRID)
# Copy to .env and fill values
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Agent Hub V3"
VERSION="3.0.0"
SECRET_KEY=replace-with-secure-random-string

# --- API ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (HYBRID) ---
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true

# OpenAI (primary)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
OPENAI_TEMPERATURE=0.7

# Ollama (local fallback or primary)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120

# --- DATABASE ---
DATABASE_URL=sqlite+aiosqlite:///./data/ai_agent_hub.db

# --- VECTOR STORE ---
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./data/vector_store/faiss_index
FAISS_DIMENSION=384

# --- EMBEDDINGS (LOCAL ONLY) ---
HF_HOME=./data/hf_cache
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=mps

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/ai_agent_hub.log

# --- MCP ---
MCP_ENABLED=false
MCP_SERVERS=["filesystem", "web-search"]

# --- WORKSPACE ---
WORKSPACE_ROOT=./workspace
WORKSPACE_MAX_SIZE_MB=1024

# --- SECURITY ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- FEATURE FLAGS ---
FEATURE_BASE_LAYER=true
FEATURE_PRO_LAYER=false
FEATURE_GRAPH_RAG=false
FEATURE_CANVAS=false
FEATURE_SEMANTIC_MEMORY=false
FEATURE_MULTI_AGENT=false

# --- HARDWARE ---
TORCH_DEVICE=auto
USE_MPS=true