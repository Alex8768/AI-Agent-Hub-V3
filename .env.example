# ==============================================================================
# AI AGENT HUB V3 - CONFIGURATION TEMPLATE
# ==============================================================================
# Copy to .env and fill with your values
# ==============================================================================

# --- APP CORE ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Agent Hub V3"
VERSION="3.0.0"
SECRET_KEY=your-secure-secret-key-here-change-in-production

# --- API & NETWORKING ---
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- LLM CONFIGURATION ---
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-placeholder-for-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120

# Anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder-for-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=30

# --- DATABASE ---
DATABASE_URL=sqlite+aiosqlite:///./data/ai_agent_hub.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- VECTOR STORES ---
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./data/vector_store/faiss_index
FAISS_DIMENSION=1536

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ai_agent_hub_v3

# --- REDIS ---
REDIS_URL=redis://localhost:6379/0

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/ai_agent_hub.log

# --- MCP ---
MCP_ENABLED=false
MCP_SERVERS=["filesystem", "web-search"]

# --- WORKSPACE ---
WORKSPACE_ROOT=./workspace
WORKSPACE_MAX_SIZE_MB=1024

# --- SECURITY ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- FEATURE FLAGS ---
FEATURE_BASE_LAYER=true
FEATURE_PRO_LAYER=false
FEATURE_GRAPH_RAG=false
FEATURE_CANVAS=false
FEATURE_SEMANTIC_MEMORY=false
FEATURE_MULTI_AGENT=false

# --- HARDWARE ---
TORCH_DEVICE=auto
USE_MPS=true