# ==============================================================================
# AI AGENT HUB V3 - FULL LOCAL MODE
# 100% автономный режим
# ==============================================================================

# --- APP CORE ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Agent Hub V3"
VERSION="3.0.0"

# --- API ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==============================================================================
# LLM (ONLY OLLAMA)
# ==============================================================================

LLM_PROVIDER=ollama
LLM_FALLBACK_ENABLED=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180

# OpenAI intentionally empty
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=
OPENAI_MAX_RETRIES=
OPENAI_TEMPERATURE=

# ==============================================================================
# DATABASE
# ==============================================================================

DATABASE_URL=sqlite+aiosqlite:///./data/ai_agent_hub.db

# ==============================================================================
# VECTOR STORE (LOCAL FAISS)
# ==============================================================================

VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./data/vector_store/faiss_index
FAISS_DIMENSION=384

# ==============================================================================
# EMBEDDINGS (100% LOCAL, OFFLINE)
# ==============================================================================

HF_HOME=./data/hf_cache
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=mps   # cpu если не Apple Silicon

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=INFO