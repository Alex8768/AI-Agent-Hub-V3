# ==============================================================================
# AI AGENT HUB V3 - PRODUCTION (HYBRID)
# ==============================================================================

# --- APP CORE ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI Agent Hub V3"
VERSION="3.0.0"
SECRET_KEY=generate-with-openssl-rand-base64-48

# --- API ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://your-domain.com"]
ALLOWED_HOSTS=["your-domain.com"]

# --- LLM (PRIMARY = OPENAI, OPTIONAL FALLBACK = OLLAMA) ---
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true

# OpenAI
OPENAI_API_KEY=sk-prod-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=5
OPENAI_TEMPERATURE=0.7

# Ollama fallback (if you deploy Ollama in prod)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=180

# --- DATABASE ---
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/ai_agent_hub
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# --- VECTOR STORE ---
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=/var/lib/ai_agent_hub/vector_store/faiss_index
FAISS_DIMENSION=384

# --- EMBEDDINGS (LOCAL ONLY) ---
HF_HOME=/var/lib/ai_agent_hub/hf_cache
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# --- LOGGING ---
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_FILE=/var/log/ai_agent_hub/app.log

# --- MCP ---
MCP_ENABLED=false

# --- WORKSPACE ---
WORKSPACE_ROOT=/var/lib/ai_agent_hub/workspace
WORKSPACE_MAX_SIZE_MB=5120

# --- SECURITY ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_PERIOD=3600
CSRF_ENABLED=true

# --- FEATURE FLAGS ---
FEATURE_BASE_LAYER=true
FEATURE_PRO_LAYER=true
FEATURE_GRAPH_RAG=true
FEATURE_CANVAS=true
FEATURE_SEMANTIC_MEMORY=true
FEATURE_MULTI_AGENT=false

# --- MONITORING ---
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=true
JAEGER_HOST=jaeger.prod.svc.cluster.local
METRICS_PORT=9091

# --- PERFORMANCE ---
WORKER_COUNT=4
MAX_REQUEST_SIZE=10MB
REQUEST_TIMEOUT=300

# --- HARDWARE ---
TORCH_DEVICE=cpu