# ==============================================================================
# AI AGENT HUB V3 - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy to .env.production on your production server
# ==============================================================================

# --- APP CORE ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="AI Agent Hub V3"
VERSION="3.0.0"
SECRET_KEY=generate-with-openssl-rand-base64-48

# --- API & NETWORKING ---
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://your-domain.com","https://app.your-domain.com"]
ALLOWED_HOSTS=["your-domain.com","api.your-domain.com","localhost"]

# --- LLM CONFIGURATION ---
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true

# OpenAI Production
OPENAI_API_KEY=ssk-placeholder-for-openai-api-key
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=5
OPENAI_TEMPERATURE=0.7

# Anthropic Production Fallback
ANTHROPIC_API_KEY=sk-ant-prod-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=30

# --- DATABASE ---
DATABASE_URL=postgresql+asyncpg://user:password@prod-db:5432/ai_agent_hub_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# --- VECTOR STORES ---
VECTOR_STORE_PROVIDER=qdrant
QDRANT_HOST=qdrant-prod
QDRANT_PORT=6333
QDRANT_COLLECTION=ai_agent_hub_prod
QDRANT_TIMEOUT=10

# --- REDIS ---
REDIS_URL=redis://:password@redis-prod:6379/0
REDIS_MAX_CONNECTIONS=100

# --- LOGGING ---
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_FILE=/var/log/ai_agent_hub/app.log

# --- MCP ---
MCP_ENABLED=false

# --- WORKSPACE ---
WORKSPACE_ROOT=/var/lib/ai_agent_hub/workspace
WORKSPACE_MAX_SIZE_MB=5120

# --- SECURITY ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_PERIOD=3600
CSRF_ENABLED=true

# --- FEATURE FLAGS ---
FEATURE_BASE_LAYER=true
FEATURE_PRO_LAYER=true
FEATURE_GRAPH_RAG=true
FEATURE_CANVAS=true
FEATURE_SEMANTIC_MEMORY=true
FEATURE_MULTI_AGENT=false

# --- MONITORING ---
PROMETHEUS_ENABLED=true
JAEGER_ENABLED=true
JAEGER_HOST=jaeger.prod.svc.cluster.local
METRICS_PORT=9091

# --- PERFORMANCE ---
WORKER_COUNT=4
MAX_REQUEST_SIZE=10MB
REQUEST_TIMEOUT=300

# --- HARDWARE ---
TORCH_DEVICE=cpu